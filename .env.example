# ── Client-side (safe to be in the app bundle) ────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Server-side only (NEVER use EXPO_PUBLIC_ prefix for these) ────────────────
# ANTHROPIC_API_KEY lives in the Supabase Edge Function as a secret, NOT here.
# Set it with: supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# It must NEVER be bundled into the app.
